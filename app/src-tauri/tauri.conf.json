{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ciclo Assist",
  "version": "0.1.0",
  "identifier": "com.ciclomedia.cicloassist",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/256x256.png", "icons/icon.png", "icons/icon.ico"],
    "publisher": "Ciclo Media",
    "shortDescription": "Ciclo Assist",
    "longDescription": "A janela do Ciclo Assist: sobe o serviço local e mostra o painel, operando o Media Composer e o Premiere por fora."
  }
}
